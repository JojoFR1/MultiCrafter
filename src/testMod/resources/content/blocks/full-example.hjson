#======================================================================================================================#
# This file contains all the variables and their default values that can be used in the library.
# You are not supposed to use this file as is, it is only for reference. You can copy the variables you want to use in
#   your own block file and adjust the values to your needs.
# You can also add any vanilla block (the base 'Block') variable, as long as it is supported by the game (the game
#   will log a warn and ignore any unsupported variable).
# Please read all the comments, as they contain important information about the variables and their usage.
#======================================================================================================================#

#======================================================================================================================#
# Small tips to convert from ticks to seconds and vice versa:
#     Ticks --> Seconds: ticks / 60 = seconds
#       example: 80 ticks / 60 = 1.33 seconds
#     Seconds --> Ticks: seconds * 60 = ticks
#       example: 1.33 seconds * 60 = 80 ticks
#======================================================================================================================#

# Mandatory, defines the block as a multicrafter
type: MultiCrafter
# You can also define the block as a multicrafter with attribute support. YOU CANNOT USE BOTH TYPE!
type: AttributeMultiCrafter

# You can define any vanilla block variable below, as long as it is supported by the game. All values are examples.
size: 2
itemCapacity: 15

drawer: {
    type: DrawDefault
}
# A special drawer, 'DrawRecipe', can be used to draw the recipes drawer at its place. You CANNOT have the two versions (above and below) at the same time, it is just a choice.
drawer: {
    type: DrawMulti
    drawers: [
        {
            # The recipe specific drawer will be drawn here
            type: DrawRecipe
        }
        {
            type: DrawDefault
        }
    ]
}


##### The library specific variables, all default values. You do not need to define all of them, only the ones you want to change.

# If true, the selection menu will be disabled and the recipe will be selected based off the input and weights.
# This system is experimental and may not work as expected in all cases.
autoSelectRecipe: false

## AttributeMultiCrafter only vvv
# Same variables as the vanilla AttributeCrafter
attribute: heat
baseEfficiency: 1.0
boostScale: 1.0
maxBoost: 1.0
minEfficiency: -1.0

# If the efficiency (baseEfficiency + tile attribute value) is below minEfficiency, the crafter will not be buildable.

displayEfficiencyScale: 1.0
displayEfficiency: true
scaleLiquidConsumption: false

## AttributeMultiCrafter only ^^^

# /!\ The field 'recipes' won't work as it is only intended for internal and Java mod use. Using it will not work!
jsonRecipes: [
    # This is one recipe, defined in between two braces {}.
    {
        # The internal name of the recipe. Make sure to use a unique name.
        name: empty-recipe
        # The name displayed in-game instead of the internal name (above). It is recommended to use bundles for localization.
        # For bundles: "recipe.name.key=value", key can be: 'name', 'description', 'details' or 'credit'.
        localizedName: "Empty Recipe"

        # When 'autoSelectRecipe' is true, this weight will influence which recipe will be selected in case of multiple valid recipes.
        # The higher weighted recipe will be selected.
        weight: 1.0

        # The time, in tick, it takes to craft the recipe.
        craftTime: 80
        input: {
            items: []
            # Liquid consumption is per second, so it will consume: x liquid amount * 60 ticks * craftTime seconds, for a single craft.
            liquids: [] # Values are per tick! Divide the desired amount by 60 to get the correct amount (the game run at 60 ticks per second)
            # Power consumption is per second, so it will consume: x power amount * 60 ticks * craftTime seconds, for a single craft.
            power: 0 # Value is per tick! Divide the desired amount by 60 to get the correct amount (the game run at 60 ticks per second)
            heat: 0
            // payloads: [] # NOT SUPPORTED YET! IT WON'T DO ANYTHING!
        }
        output: {
            items: []
            # Liquid consumption is per second, so it will consume: x liquid amount * 60 ticks * craftTime seconds, for a single craft.
            liquids: [] # Values are per tick! Divide the desired amount by 60 to get the correct amount (the game run at 60 ticks per second)
            # Power consumption is per second, so it will consume: x power amount * 60 ticks * craftTime seconds, for a single craft.
            power: 0 # Value is per tick! Divide the desired amount by 60 to get the correct amount (the game run at 60 ticks per second)
            heat: 0
            // payloads: [] # NOT SUPPORTED YET! IT WON'T DO ANYTHING!
        }
        # Example for amount to amount/tick conversion:
        #     10 water/second = 10 / 60 = 0.167 water/tick
        #     0.83 water/tick = 0.83 * 60 = 50 water/second
        # It works for power or liquids quantity.

        craftEffect: none
        updateEffect: none
        updateEffectChance: 0.04
        updateEffectSpread: 4
        warmupSpeed: 0.019

        # Only for recipes with heat.
        warmupRate: 0.15
        overheatScale: 1
        maxEfficiency: 4

        # If true, the crafter will output a random item from the output list, like a Separator/Disassembler.
        # Only support items, all other output types will be forbidden and will thrown an error if defined.
        randomOutput: false

        ## AttributeMultiCrafter only vvv

        ## All values will take precedence over the block values, if defined. If not defined, the block values will be used.

        # The values below are considered 'not defined', but they are not valid values! They are only a representation of the default Java value.
        # If you want to use the block value, do not define them at all.
        # If you want to override the block value, define them with a valid value (not NaN or 'null').
        attribute: null
        # The 'none' value is only to make the test mod work, please ignore. It does not exist in the game and will be ignored.
        attribute: none
        baseEfficiency: NaN
        boostScale: NaN
        maxBoost: NaN
        minEfficiency: NaN

        ## AttributeMultiCrafter only ^^^

        # If false, the recipe will need to be researched to unlock. Useful for recipes that needs items unlocked later in your progression.
        unlocked: false
        # If true, the recipe will always be unlocked, even after a research tree reset.
        alwaysUnlocked: false

        # If you have previously defined your recipe as unlocked and loaded the game, then later switched to locked,
        #   the recipe will not automatically be locked. You will need to reset the research tree to lock it again, or lock this specific recipe using the console.
        # To make a recipe locked, in the console: Vars.content.getByName(ContentType.typeid_UNUSED, "modname-recipename").clearUnlock()

        # Any unlockable content, including any other recipes from this or other block (must have been loaded before!). The content *has* to be in the research tree.
        research: core-shard
        # or, like vanilla... (do not use both!)
        research: {
            parent: core-shard
            requirements: []
            objectives: []
        }

        # This drawer will be drawn at the place of a 'DrawRecipe' in the block drawer.
        drawer: {
            type: DrawDefault
        }
    }
]


# Back to the default vanilla game variables, all values are examples.
requirements: ["copper/10"]
category: "crafting"
