# Mandatory, defines the block as a multicrafter
type: MultiCrafter

# You can define any vanilla block variable below, as long as it is supported by the game. All values are examples.
size: 2
itemCapacity: 15

drawer: {
    type: DrawDefault
}

## The library specific variables
# Special DrawRecipe, you cannot have the two versions (above and below) at the same time, it is just a choice.
drawer: {
    type: DrawMulti
    drawers: [
        {
            # The recipe specific drawer will be drawn here
            type: DrawRecipe
        }
        {
            type: DrawDefault
        }
    ]
}


## The library specific variables, all default values. You do not need to define all of them, only the ones you want to change.

# If true, the selection menu will be disabled and the recipe will be selected based off the input and weights.
# The recipe will only change if the input changes and that the current crafting is done.
autoSelectRecipe: false

# /!\ The field 'recipes' won't work as it is only intended for internal and Java mod use. Using it will not work!
jsonRecipes: [
    # This is one recipe, defined in between two braces {}.
    {
        # Will cause a conflict if you have multiple recipes with the same name, make sure to use a unique name.
        name: empty-recipe
        # The name displayed in-game instead of the internal name (above). It is preferred to use bundles for localization.
        # For bundles: "recipe.name.key", key can be: 'name', 'description', 'details' or 'credit'.
        localizedName: "Empty Recipe"

        # When 'autoSelectRecipe' is true, this weight will influence which recipe will be selected if the crafter has:
        #   - Multiple items of different recipes
        #   - The same item in multiple recipes
        # The higher weighted recipe will be selected.
        weight: 1.0

        # Value is per tick! Multiply the desired value (in seconds) by 60 to get the correct amount (the game run at 60 ticks per second).
        #   From ticks to seconds: 80 / 60 = 1.33 seconds
        #   From seconds to ticks: 1.33 * 60 = 80 ticks
        craftTime: 80
        input: {
            items: []
            liquids: [] # Values are per tick! Divide the desired amount by 60 to get the correct amount (the game run at 60 ticks per second)
            power: 0 # Value is per tick! Divide the desired amount by 60 to get the correct amount (the game run at 60 ticks per second)
            heat: 0
            // payloads: [] # NOT SUPPORTED YET! IT WON'T DO ANYTHING!
        }
        output: {
            items: []
            liquids: [] # Values are per tick! Divide the desired amount by 60 to get the correct amount (the game run at 60 ticks per second)
            power: 0 # Value is per tick! Divide the desired amount by 60 to get the correct amount (the game run at 60 ticks per second)
            heat: 0
            // payloads: [] # NOT SUPPORTED YET! IT WON'T DO ANYTHING!
        }
        # Example for amount to amount/tick conversion:
        #     10 water/second = 10 / 60 = 0.167 water/tick
        #     0.83 water/tick = 0.83 * 60 = 50 water/second
        # It works for power or liquids quantity.

        craftEffect: none
        updateEffect: none
        updateEffectChance: 0.04
        updateEffectSpread: 4
        warmupSpeed: 0.019

        # Only for heat based block
        warmupRate: 0.15
        overheatScale: 1
        maxEfficiency: 4

        # If false, the recipe will need to be researched to unlock. Useful for recipes that needs items unlocked later in your progression.
        unlocked: false
        # If true, the recipe will always be unlocked, even after a research tree reset.
        alwaysUnlocked: false

        # Any unlockable content, including any other recipes from this or other block (must have been loaded before!). The content *has* to be in the research tree.
        research: core-shard
        # or, like vanilla... (do not use both!)
        research: {
            parent: core-shard
            requirements: []
            objectives: []
        }

        # This drawer will be drawn at the place of a 'DrawRecipe' in the block drawer.
        drawer: {
            type: DrawDefault
        }
    }
]


# Back to the default vanilla game variables, all values are examples.
requirements: ["copper/10"]
category: "crafting"
